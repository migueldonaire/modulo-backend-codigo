# Copia este archivo como .env: cp .env.example .env
# Los valores ya sirven para el contenedor de clase (postgres-sql, usuario alumno).

# Puerto de la API (en Render lo pone Render)
PORT=3000

# Conexión a PostgreSQL: postgres://usuario:contraseña@servidor:puerto/base_de_datos
# En Render, pon aquí la de Supabase (Session pooler, con ?sslmode=no-verify al final).
DATABASE_URL=postgres://alumno:alumno_dev_123@localhost:5432/bootcamp_api

# Clave para firmar los tokens JWT. Cámbiala por un texto largo y aleatorio,
# distinta en cada entorno. Nunca la subas a GitHub.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
