# Copia este archivo como .env: cp .env.example .env
# Los valores ya sirven para el contenedor de clase (mongodb-practica o el compose.yaml).

# Puerto de la API (en Render lo pone Render)
PORT=3000

# Conexión a MongoDB: usuario admin y contraseña de clase.
# En Render, pon aquí la URI de MongoDB Atlas.
MONGODB_URI=mongodb://admin:admin_dev_123@localhost:27017/?authSource=admin

# Base de datos donde se guardan los productos
DB_NAME=bootcamp_api
